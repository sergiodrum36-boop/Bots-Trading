# Plantilla de variables de entorno. Copia este archivo como ".env" y
# rellena tus claves reales. ".env" NUNCA debe subirse a git (ver .gitignore).
#
# Genera claves de PAPER TRADING en https://app.alpaca.markets/paper/dashboard/overview
# Son distintas de las claves de cuenta real -- no las mezcles.

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Informativo: alpaca-py ya selecciona el endpoint correcto segun el flag
# `paper` con el que se instancie TradingClient, pero lo documentamos aqui
# por transparencia y para futuros usos (scripts, curl manual, etc.).
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Feed de datos de mercado. "iex" es gratuito y el disponible por defecto
# en cuentas de paper trading. "sip" requiere suscripcion Algo Trader Plus.
APCA_DATA_FEED=iex

# OPCIONAL -- solo si quieres que scripts/run_paper_trading.py y
# dashboard/app.py usen una base de datos remota (Postgres/Supabase) en vez
# del SQLite local por defecto. Vacio/sin definir = SQLite local, como
# hasta ahora. En GitHub Actions esto se define como Secret, NUNCA aqui
# (ver .github/workflows/ciclo_diario.yml) -- usa el connection string del
# "Transaction pooler" de Supabase (puerto 6543), pensado para conexiones
# cortas y frecuentes como esta, no el connection string "directo".
TRADING_BOT_DATABASE_URL=
